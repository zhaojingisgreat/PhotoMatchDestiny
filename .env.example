# DeepSeek API Key（必填）
# 从 https://platform.deepseek.com/ 获取
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# DeepSeek 模型名称
# 使用 deepseek-chat 支持图片分析（通过 Anthropic 兼容端点）
DEEPSEEK_MODEL=deepseek-chat

# App URL
NEXT_PUBLIC_APP_URL=https://photomatchdestiny.com

# Google Analytics (可选)
# 从 https://analytics.google.com/ 获取 Measurement ID (格式: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
